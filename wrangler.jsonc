{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crystal-bracelet-api",
  "main": "worker/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "crystal-bracelet-db",
      "database_id": "crystal-bracelet-db-local"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BEAD_IMAGES",
      "bucket_name": "crystal-bracelet-images"
    }
  ],
  "vars": {
    "CORS_ORIGIN": "https://crystal-bracelet-studio.pages.dev"
  },
  "env": {
    "staging": {
      "name": "crystal-bracelet-api-staging",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "crystal-bracelet-db-staging",
          "database_id": "7c1e0a16-a9d1-4c4a-b843-8d7a9089ee79"
        }

      ],
      "r2_buckets": [
        {
          "binding": "BEAD_IMAGES",
          "bucket_name": "crystal-bracelet-images-staging"
        }
      ],
      "vars": {
        "CORS_ORIGIN": "https://staging.crystal-bracelet-studio.pages.dev"
      }
    }
  }
}

